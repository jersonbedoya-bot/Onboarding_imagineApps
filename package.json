{
  "name": "onboarding-imagineapps",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "20.19.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:bootstrap": "node --env-file=.env.local --import tsx ./scripts/bootstrap-db.ts",
    "db:verify": "node --env-file=.env.local --import tsx ./scripts/verify-validation.ts",
    "db:seed": "node --env-file=.env.local --import tsx ./scripts/seed-bootstrap.ts",
    "db:seed:content": "node --env-file=.env.local --import tsx ./scripts/seed-content.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "mongodb": "^7.5.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
