# Copiar a .env.local y completar con valores reales. Nunca commitear .env.local.

# MongoDB Atlas — connection string del cluster (incluye usuario y password embebidos).
MONGODB_URI=

# Secreto de firma de JWT (NextAuth). Generar con: openssl rand -base64 32
AUTH_SECRET=

# URL pública de la app (usada para construir links de activación de invitaciones).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob — token de lectura/escritura. Se autoinyecta en Vercel al linkear
# un Blob store al proyecto; en local hay que copiarlo manualmente desde el dashboard.
# No requerido hasta la Fase 3 (subida de media).
BLOB_READ_WRITE_TOKEN=

# --- Backlog (no usado en el MVP) ---
# Envío de email transaccional real (Resend u otro): se agrega cuando exista
# un caso de uso que lo requiera. La invitación del MVP es un link copiable
# que el admin comparte manualmente, no un envío automático.
